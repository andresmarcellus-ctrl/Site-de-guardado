{
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
font-family: Arial, Helvetica, sans-serif;
background: #f5f7fa;
color: #1f2937;
}

/* CABEÇALHO */

.topo {
background: #111827;
color: white;
padding: 25px 8%;
display: flex;
align-items: center;
justify-content: space-between;
}

.logo {
display: flex;
align-items: center;
gap: 12px;
}

.logo span {
color: #22c55e;
font-size: 28px;
font-weight: bold;
}

.logo h1 {
font-size: 24px;
}

.topo p {
color: #9ca3af;
}

/* CONTEÚDO */

.container {
width: 84%;
max-width: 1200px;
margin: 45px auto;
}

.cabecalho-projetos {
display: flex;
align-items: center;
justify-content: space-between;
margin-bottom: 30px;
}

.cabecalho-projetos h2 {
font-size: 28px;
margin-bottom: 5px;
}

.cabecalho-projetos p {
color: #6b7280;
}

/* BOTÃO + */

.botao-adicionar {
width: 55px;
height: 55px;

border: none;
border-radius: 50%;

background: #22c55e;
color: white;

font-size: 35px;
line-height: 50px;

cursor: pointer;

transition: 0.2s;


}

.botao-adicionar:hover {
background: #16a34a;
transform: scale(1.08);
}

/* PROJETOS */

.projetos {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
gap: 20px;
}

.projeto {
background: white;

border: 1px solid #e5e7eb;
border-radius: 12px;

padding: 22px;

cursor: pointer;

transition: 0.2s;


}

.projeto:hover {
transform: translateY(-3px);
border-color: #22c55e;

box-shadow: 0 8px 25px rgba(0,0,0,0.08);


}

.projeto-cabecalho {
display: flex;
align-items: center;
gap: 12px;

margin-bottom: 15px;


}

.icone-pasta {
font-size: 30px;
}

.projeto h3 {
font-size: 19px;
}

.projeto-descricao {
color: #6b7280;
font-size: 14px;

min-height: 40px;

margin-bottom: 20px;


}

.projeto-info {
border-top: 1px solid #eee;

padding-top: 12px;

font-size: 12px;
color: #9ca3af;


}

/* MODAL */

.modal {
display: none;

position: fixed;

inset: 0;

background: rgba(0,0,0,0.55);

justify-content: center;
align-items: center;

padding: 20px;

z-index: 100;


}

.modal-conteudo {
position: relative;

background: white;

width: 100%;
max-width: 650px;

max-height: 90vh;

overflow-y: auto;

padding: 30px;

border-radius: 14px;


}

.fechar {
position: absolute;

right: 20px;
top: 15px;

border: none;
background: none;

font-size: 28px;

cursor: pointer;

color: #6b7280;


}

.modal-conteudo h2 {
margin-bottom: 8px;
}

.modal-conteudo > p {
color: #6b7280;
margin-bottom: 25px;
}

/* FORMULÁRIO */

label {
display: block;

font-weight: bold;

margin: 15px 0 7px;


}

input,
textarea {
width: 100%;

border: 1px solid #d1d5db;
border-radius: 8px;

padding: 12px;

font-family: inherit;

outline: none;


}

input:focus,
textarea:focus {
border-color: #22c55e;
}

textarea {
resize: vertical;

min-height: 80px;


}

.editor {
min-height: 300px;

background: #111827;

color: #e5e7eb;

font-family: "Courier New", monospace;

line-height: 1.5;


}

/* BOTÕES */

.botao-salvar {
width: 100%;

margin-top: 20px;

padding: 13px;

border: none;
border-radius: 8px;

background: #22c55e;

color: white;

font-weight: bold;

cursor: pointer;


}

.botao-salvar:hover {
background: #16a34a;
}

.botao-secundario {
padding: 12px 20px;

border: none;
border-radius: 8px;

background: #e5e7eb;

cursor: pointer;


}

/* EDITOR */

.acoes-editor {
display: flex;

gap: 10px;

margin-top: 10px;


}

.acoes-editor .botao-salvar {
margin-top: 0;
}

.historico {
margin-top: 30px;

border-top: 1px solid #e5e7eb;

padding-top: 20px;


}

.historico h3 {
margin-bottom: 15px;
}

.versao {
background: #f9fafb;

border: 1px solid #e5e7eb;

border-radius: 8px;

padding: 12px;

margin-bottom: 10px;

font-size: 13px;


}

.versao strong {
color: #16a34a;
}

@media (max-width: 700px) {

.topo {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
}

.container {
    width: 92%;
}

.cabecalho-projetos h2 {
    font-size: 23px;
}


}